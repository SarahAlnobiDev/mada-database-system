<mxfile host="app.diagrams.net" modified="2026-09-09T00:00:00.000Z" agent="ChatGPT" version="24.7.17" type="device"><diagram id="mada" name="Database Schema"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3600" pageHeight="2350" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="&lt;div style=&quot;background-color:#123B5D;color:white;text-align:center;padding:6px;&quot;&gt;&lt;b&gt;DEPARTMENT&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;&quot;&gt;[PK] department_id NUMBER IDENTITY DEFAULT ON&lt;br&gt;[UQ] department_name VARCHAR2(150) NOT NULL&lt;br&gt;[UQ] department_code VARCHAR2(30) NOT NULL&lt;br&gt;&lt;b&gt;Constraints&lt;/b&gt;&lt;br&gt;UNIQUE(department_name)&lt;br&gt;UNIQUE(department_code)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F9FC;strokeColor=#123B5D;strokeWidth=2;fontSize=13;fontColor=#1D2A33;align=left;verticalAlign=top;spacingTop=8;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="50" y="90" width="520" height="195" as="geometry" /></mxCell><mxCell id="3" value="&lt;div style=&quot;background-color:#123B5D;color:white;text-align:center;padding:6px;&quot;&gt;&lt;b&gt;USER_ACCOUNT&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;&quot;&gt;[PK] user_id NUMBER IDENTITY DEFAULT ON&lt;br&gt;full_name VARCHAR2(200) NOT NULL&lt;br&gt;[UQ] university_id VARCHAR2(30)&lt;br&gt;[UQ] email VARCHAR2(254) NOT NULL&lt;br&gt;password_hash VARCHAR2(255) NOT NULL&lt;br&gt;role VARCHAR2(20) NOT NULL&lt;br&gt;[FK] department_id NUMBER -&amp;gt; department.department_id&lt;br&gt;account_status VARCHAR2(20) DEFAULT &amp;#x27;ACTIVE&amp;#x27; NOT NULL&lt;br&gt;created_at TIMESTAMP DEFAULT SYSTIMESTAMP NOT NULL&lt;br&gt;&lt;b&gt;Constraints&lt;/b&gt;&lt;br&gt;UNIQUE(university_id)&lt;br&gt;UNIQUE(email)&lt;br&gt;CHECK role IN (&amp;#x27;STUDENT&amp;#x27;, &amp;#x27;DOCTOR&amp;#x27;, &amp;#x27;ADMIN&amp;#x27;)&lt;br&gt;CHECK account_status IN (&amp;#x27;ACTIVE&amp;#x27;, &amp;#x27;INACTIVE&amp;#x27;)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F9FC;strokeColor=#123B5D;strokeWidth=2;fontSize=13;fontColor=#1D2A33;align=left;verticalAlign=top;spacingTop=8;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="560" y="90" width="520" height="411" as="geometry" /></mxCell><mxCell id="4" value="&lt;div style=&quot;background-color:#123B5D;color:white;text-align:center;padding:6px;&quot;&gt;&lt;b&gt;COURSE&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;&quot;&gt;[PK] course_id NUMBER IDENTITY DEFAULT ON&lt;br&gt;[UQ] course_code VARCHAR2(30) NOT NULL&lt;br&gt;course_name VARCHAR2(150) NOT NULL&lt;br&gt;[FK] department_id NUMBER NOT NULL -&amp;gt; department.department_id&lt;br&gt;credit_hours NUMBER(2) NOT NULL&lt;br&gt;&lt;b&gt;Constraints&lt;/b&gt;&lt;br&gt;UNIQUE(course_code)&lt;br&gt;CHECK credit_hours BETWEEN 1 AND 12&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F9FC;strokeColor=#123B5D;strokeWidth=2;fontSize=13;fontColor=#1D2A33;align=left;verticalAlign=top;spacingTop=8;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1160" y="90" width="520" height="249" as="geometry" /></mxCell><mxCell id="5" value="&lt;div style=&quot;background-color:#123B5D;color:white;text-align:center;padding:6px;&quot;&gt;&lt;b&gt;COURSE_ASSIGNMENT&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;&quot;&gt;[PK] assignment_id NUMBER IDENTITY DEFAULT ON&lt;br&gt;[FK] doctor_id NUMBER NOT NULL -&amp;gt; user_account.user_id&lt;br&gt;[FK] course_id NUMBER NOT NULL -&amp;gt; course.course_id&lt;br&gt;semester VARCHAR2(20) NOT NULL&lt;br&gt;academic_year NUMBER(4) NOT NULL&lt;br&gt;&lt;b&gt;Constraints&lt;/b&gt;&lt;br&gt;UNIQUE(doctor_id, course_id, semester, academic_year)&lt;br&gt;CHECK semester IN (&amp;#x27;FIRST&amp;#x27;, &amp;#x27;SECOND&amp;#x27;, &amp;#x27;SUMMER&amp;#x27;)&lt;br&gt;CHECK academic_year BETWEEN 2000 AND 2200&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F9FC;strokeColor=#123B5D;strokeWidth=2;fontSize=13;fontColor=#1D2A33;align=left;verticalAlign=top;spacingTop=8;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1710" y="90" width="520" height="276" as="geometry" /></mxCell><mxCell id="6" value="&lt;div style=&quot;background-color:#123B5D;color:white;text-align:center;padding:6px;&quot;&gt;&lt;b&gt;PROJECT_FILE&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;&quot;&gt;[PK] file_id NUMBER IDENTITY DEFAULT ON&lt;br&gt;[FK] project_id NUMBER NOT NULL -&amp;gt; project.project_id ON DELETE CASCADE&lt;br&gt;[FK] uploaded_by NUMBER NOT NULL -&amp;gt; user_account.user_id&lt;br&gt;file_name VARCHAR2(255) NOT NULL&lt;br&gt;file_type VARCHAR2(50) NOT NULL&lt;br&gt;file_url VARCHAR2(1000) NOT NULL&lt;br&gt;access_level VARCHAR2(20) DEFAULT &amp;#x27;PUBLIC&amp;#x27; NOT NULL&lt;br&gt;file_size_kb NUMBER(12,2)&lt;br&gt;uploaded_at TIMESTAMP DEFAULT SYSTIMESTAMP NOT NULL&lt;br&gt;&lt;b&gt;Constraints&lt;/b&gt;&lt;br&gt;CHECK access_level IN (&amp;#x27;PUBLIC&amp;#x27;, &amp;#x27;RESTRICTED&amp;#x27;)&lt;br&gt;CHECK file_size_kb IS NULL OR file_size_kb &amp;gt;= 0&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F9FC;strokeColor=#123B5D;strokeWidth=2;fontSize=13;fontColor=#1D2A33;align=left;verticalAlign=top;spacingTop=8;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="50" y="800" width="520" height="357" as="geometry" /></mxCell><mxCell id="7" value="&lt;div style=&quot;background-color:#123B5D;color:white;text-align:center;padding:6px;&quot;&gt;&lt;b&gt;PROJECT_MEMBER&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;&quot;&gt;[PK/FK] project_id NUMBER NOT NULL -&amp;gt; project.project_id ON DELETE CASCADE&lt;br&gt;[PK/FK] student_id NUMBER NOT NULL -&amp;gt; user_account.user_id&lt;br&gt;member_role VARCHAR2(100)&lt;br&gt;contribution_description VARCHAR2(1000)&lt;br&gt;joined_at TIMESTAMP DEFAULT SYSTIMESTAMP NOT NULL&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F9FC;strokeColor=#123B5D;strokeWidth=2;fontSize=13;fontColor=#1D2A33;align=left;verticalAlign=top;spacingTop=8;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="580" y="800" width="520" height="195" as="geometry" /></mxCell><mxCell id="8" value="&lt;div style=&quot;background-color:#123B5D;color:white;text-align:center;padding:6px;&quot;&gt;&lt;b&gt;PROJECT&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;&quot;&gt;[PK] project_id NUMBER IDENTITY DEFAULT ON&lt;br&gt;title VARCHAR2(250) NOT NULL&lt;br&gt;summary VARCHAR2(1000)&lt;br&gt;problem_statement CLOB&lt;br&gt;solution_description CLOB&lt;br&gt;project_type VARCHAR2(20) NOT NULL&lt;br&gt;academic_status VARCHAR2(30) DEFAULT &amp;#x27;IN_DEVELOPMENT&amp;#x27; NOT NULL&lt;br&gt;workflow_status VARCHAR2(30) DEFAULT &amp;#x27;NOMINATED&amp;#x27; NOT NULL&lt;br&gt;is_featured NUMBER(1) NOT NULL&lt;br&gt;nomination_reason VARCHAR2(1000)&lt;br&gt;[FK] nominated_by NUMBER NOT NULL -&amp;gt; user_account.user_id&lt;br&gt;created_at TIMESTAMP DEFAULT SYSTIMESTAMP NOT NULL&lt;br&gt;published_at TIMESTAMP&lt;br&gt;&lt;b&gt;Constraints&lt;/b&gt;&lt;br&gt;CHECK project_type IN (&amp;#x27;COURSE&amp;#x27;, &amp;#x27;GRADUATION&amp;#x27;)&lt;br&gt;CHECK academic_status IN (&amp;#x27;COMPLETED&amp;#x27;, &amp;#x27;INCOMPLETE&amp;#x27;, &amp;#x27;IN_DEVELOPMENT&amp;#x27;)&lt;br&gt;CHECK workflow_status IN (&amp;#x27;NOMINATED&amp;#x27;, &amp;#x27;DRAFT&amp;#x27;, &amp;#x27;SUBMITTED&amp;#x27;, &amp;#x27;REVISION_REQUIRED&amp;#x27;, &amp;#x27;APPROVED&amp;#x27;, &amp;#x27;PUBLISHED&amp;#x27;, &amp;#x27;ARCHIVED&amp;#x27;)&lt;br&gt;CHECK is_featured IN (0, 1)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F9FC;strokeColor=#123B5D;strokeWidth=2;fontSize=13;fontColor=#1D2A33;align=left;verticalAlign=top;spacingTop=8;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1160" y="690" width="610" height="519" as="geometry" /></mxCell><mxCell id="9" value="&lt;div style=&quot;background-color:#123B5D;color:white;text-align:center;padding:6px;&quot;&gt;&lt;b&gt;COURSE_PROJECT_DETAILS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;&quot;&gt;[PK/FK] project_id NUMBER NOT NULL -&amp;gt; project.project_id ON DELETE CASCADE&lt;br&gt;[FK] assignment_id NUMBER NOT NULL -&amp;gt; course_assignment.assignment_id&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F9FC;strokeColor=#123B5D;strokeWidth=2;fontSize=13;fontColor=#1D2A33;align=left;verticalAlign=top;spacingTop=8;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1850" y="740" width="520" height="114" as="geometry" /></mxCell><mxCell id="10" value="&lt;div style=&quot;background-color:#123B5D;color:white;text-align:center;padding:6px;&quot;&gt;&lt;b&gt;GRADUATION_PROJECT_DETAILS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;&quot;&gt;[PK/FK] project_id NUMBER NOT NULL -&amp;gt; project.project_id ON DELETE CASCADE&lt;br&gt;[FK] supervisor_id NUMBER NOT NULL -&amp;gt; user_account.user_id&lt;br&gt;graduation_year NUMBER(4) NOT NULL&lt;br&gt;project_stage VARCHAR2(30) DEFAULT &amp;#x27;IN_PROGRESS&amp;#x27; NOT NULL&lt;br&gt;defense_date DATE&lt;br&gt;&lt;b&gt;Constraints&lt;/b&gt;&lt;br&gt;CHECK graduation_year BETWEEN 2000 AND 2200&lt;br&gt;CHECK project_stage IN (&amp;#x27;IDEA&amp;#x27;, &amp;#x27;IN_PROGRESS&amp;#x27;, &amp;#x27;READY&amp;#x27;, &amp;#x27;DEFENDED&amp;#x27;, &amp;#x27;ARCHIVED&amp;#x27;)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F9FC;strokeColor=#123B5D;strokeWidth=2;fontSize=13;fontColor=#1D2A33;align=left;verticalAlign=top;spacingTop=8;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="2460" y="740" width="610" height="249" as="geometry" /></mxCell><mxCell id="11" value="&lt;div style=&quot;background-color:#123B5D;color:white;text-align:center;padding:6px;&quot;&gt;&lt;b&gt;PROJECT_PASSPORT&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;&quot;&gt;[PK/FK] project_id NUMBER NOT NULL -&amp;gt; project.project_id ON DELETE CASCADE&lt;br&gt;working_features CLOB&lt;br&gt;incomplete_parts CLOB&lt;br&gt;source_code_availability VARCHAR2(20) DEFAULT &amp;#x27;ON_REQUEST&amp;#x27; NOT NULL&lt;br&gt;accepts_continuation NUMBER(1) NOT NULL&lt;br&gt;future_ideas CLOB&lt;br&gt;updated_at TIMESTAMP DEFAULT SYSTIMESTAMP NOT NULL&lt;br&gt;&lt;b&gt;Constraints&lt;/b&gt;&lt;br&gt;CHECK source_code_availability IN (&amp;#x27;PUBLIC&amp;#x27;, &amp;#x27;ON_REQUEST&amp;#x27;, &amp;#x27;PRIVATE&amp;#x27;)&lt;br&gt;CHECK accepts_continuation IN (0, 1)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F9FC;strokeColor=#123B5D;strokeWidth=2;fontSize=13;fontColor=#1D2A33;align=left;verticalAlign=top;spacingTop=8;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="50" y="1570" width="520" height="303" as="geometry" /></mxCell><mxCell id="12" value="&lt;div style=&quot;background-color:#123B5D;color:white;text-align:center;padding:6px;&quot;&gt;&lt;b&gt;PROJECT_TECHNOLOGY&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;&quot;&gt;[PK/FK] project_id NUMBER NOT NULL -&amp;gt; project.project_id ON DELETE CASCADE&lt;br&gt;[PK/FK] technology_id NUMBER NOT NULL -&amp;gt; technology.technology_id&lt;br&gt;usage_note VARCHAR2(500)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F9FC;strokeColor=#123B5D;strokeWidth=2;fontSize=13;fontColor=#1D2A33;align=left;verticalAlign=top;spacingTop=8;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="650" y="1570" width="520" height="141" as="geometry" /></mxCell><mxCell id="13" value="&lt;div style=&quot;background-color:#123B5D;color:white;text-align:center;padding:6px;&quot;&gt;&lt;b&gt;TECHNOLOGY&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;&quot;&gt;[PK] technology_id NUMBER IDENTITY DEFAULT ON&lt;br&gt;[UQ] technology_name VARCHAR2(100) NOT NULL&lt;br&gt;category VARCHAR2(100)&lt;br&gt;&lt;b&gt;Constraints&lt;/b&gt;&lt;br&gt;UNIQUE(technology_name)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F9FC;strokeColor=#123B5D;strokeWidth=2;fontSize=13;fontColor=#1D2A33;align=left;verticalAlign=top;spacingTop=8;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="720" y="2050" width="520" height="168" as="geometry" /></mxCell><mxCell id="14" value="&lt;div style=&quot;background-color:#123B5D;color:white;text-align:center;padding:6px;&quot;&gt;&lt;b&gt;REVIEW&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;&quot;&gt;[PK] review_id NUMBER IDENTITY DEFAULT ON&lt;br&gt;[FK] project_id NUMBER NOT NULL -&amp;gt; project.project_id ON DELETE CASCADE&lt;br&gt;[FK] reviewer_id NUMBER NOT NULL -&amp;gt; user_account.user_id&lt;br&gt;review_decision VARCHAR2(30) NOT NULL&lt;br&gt;comments VARCHAR2(2000)&lt;br&gt;review_date TIMESTAMP DEFAULT SYSTIMESTAMP NOT NULL&lt;br&gt;round_number NUMBER(3) NOT NULL&lt;br&gt;&lt;b&gt;Constraints&lt;/b&gt;&lt;br&gt;UNIQUE(project_id, reviewer_id, round_number)&lt;br&gt;CHECK review_decision IN (&amp;#x27;PENDING&amp;#x27;, &amp;#x27;REVISION_REQUIRED&amp;#x27;, &amp;#x27;APPROVED&amp;#x27;, &amp;#x27;REJECTED&amp;#x27;)&lt;br&gt;CHECK round_number &amp;gt;= 1&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F9FC;strokeColor=#123B5D;strokeWidth=2;fontSize=13;fontColor=#1D2A33;align=left;verticalAlign=top;spacingTop=8;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1320" y="1610" width="610" height="330" as="geometry" /></mxCell><mxCell id="15" value="&lt;div style=&quot;background-color:#123B5D;color:white;text-align:center;padding:6px;&quot;&gt;&lt;b&gt;PROJECT_RELATION&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;&quot;&gt;[PK] relation_id NUMBER IDENTITY DEFAULT ON&lt;br&gt;[FK] parent_project_id NUMBER NOT NULL -&amp;gt; project.project_id ON DELETE CASCADE&lt;br&gt;[FK] child_project_id NUMBER NOT NULL -&amp;gt; project.project_id ON DELETE CASCADE&lt;br&gt;relation_type VARCHAR2(30) DEFAULT &amp;#x27;EXTENDS&amp;#x27; NOT NULL&lt;br&gt;relation_description VARCHAR2(1000)&lt;br&gt;created_at TIMESTAMP DEFAULT SYSTIMESTAMP NOT NULL&lt;br&gt;&lt;b&gt;Constraints&lt;/b&gt;&lt;br&gt;UNIQUE(parent_project_id, child_project_id, relation_type)&lt;br&gt;CHECK parent_project_id &amp;lt;&amp;gt; child_project_id&lt;br&gt;CHECK relation_type IN (&amp;#x27;EXTENDS&amp;#x27;, &amp;#x27;CONTINUATION&amp;#x27;, &amp;#x27;INSPIRED_BY&amp;#x27;)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F9FC;strokeColor=#123B5D;strokeWidth=2;fontSize=13;fontColor=#1D2A33;align=left;verticalAlign=top;spacingTop=8;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="2020" y="1620" width="610" height="303" as="geometry" /></mxCell><mxCell id="16" value="DEPARTMENT 0..N ↔ USER_ACCOUNT 0..1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#84939D;strokeWidth=1.3;endArrow=ERmany;startArrow=ERone;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="2" target="3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="17" value="DEPARTMENT 0..N ↔ COURSE 1..1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#84939D;strokeWidth=1.3;endArrow=ERmany;startArrow=ERone;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="2" target="4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="18" value="USER_ACCOUNT 0..N ↔ COURSE_ASSIGNMENT 1..1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#84939D;strokeWidth=1.3;endArrow=ERmany;startArrow=ERone;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="3" target="5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="19" value="COURSE 0..N ↔ COURSE_ASSIGNMENT 1..1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#84939D;strokeWidth=1.3;endArrow=ERmany;startArrow=ERone;fontSize=11;labelBac